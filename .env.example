# Copy to .env (make init does it for you). Values here are dev defaults.

APP_ENV=development

# HTTP server
HTTP_HOST=0.0.0.0
HTTP_PORT=8080
HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=15s
HTTP_IDLE_TIMEOUT=60s
HTTP_SHUTDOWN_TIMEOUT=15s

# Logging: debug|info|warn|error and json|text
LOG_LEVEL=debug
LOG_FORMAT=text

# Postgres. docker compose overrides POSTGRES_HOST to "db" for the api service.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=experiment
POSTGRES_SSLMODE=disable

# Set DATABASE_URL to take full control of the connection string.
# DATABASE_URL=postgres://app:app@localhost:5432/experiment?sslmode=disable

# Apply embedded migrations during startup. Convenient for dev; in production
# prefer MIGRATE_ON_START=false and run `api migrate up` as a release step.
MIGRATE_ON_START=true

# Expose GET /api/v1/burn?ms=N, a deliberate CPU sink for load/autoscaling tests.
ENABLE_BURN_ENDPOINT=true

# Connection pool
DB_MAX_CONNS=10
DB_MIN_CONNS=1
DB_MAX_CONN_LIFETIME=1h
DB_CONNECT_TIMEOUT=10s
